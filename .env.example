# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# PRIVATE manager chat: receives the full lead. May stay empty: then details are only stored in the database file.
TELEGRAM_CHAT_ID=
# PUBLIC channel: receives only anonymized posts. Never the same id as TELEGRAM_CHAT_ID.
TELEGRAM_CHANNEL_ID=
# BUILD-time variable: the public origin, inlined into the bundle by `next build` (rebuild after changing it).
NEXT_PUBLIC_SITE_URL=
# Path of the SQLite file with all leads. Leave unset locally (defaults to ./data/leads.sqlite).
# Set only on the server, never as an empty value (an empty line in a systemd EnvironmentFile overrides the unit's path).
# LEADS_DB_PATH=/data/leads.sqlite
